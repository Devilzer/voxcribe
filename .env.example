# ASR engine used by the main process.
#   whisper  - WhisperCppEngine (native whisper.cpp; inference not implemented yet)
#   mock     - MockASREngine, returns canned transcripts so the UI can be developed
MAIN_VITE_ASR_ENGINE=mock

# Minimum log level: debug | info | warn | error
MAIN_VITE_LOG_LEVEL=debug
